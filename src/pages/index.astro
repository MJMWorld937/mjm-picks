---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryTile from '../components/CategoryTile.astro';
import SetupExplorer from '../components/SetupExplorer.astro';
import { getCategories, getPublishedProducts } from '../lib/data';
import { BRAND, DISCLOSURE, href } from '../lib/site';

const [categories, products] = await Promise.all([getCategories(), getPublishedProducts()]);
const mainCategories = categories.filter((c) => c.parent_id === null);
const featured = products.filter((p) => p.featured).slice(0, 3);
const latest = products.filter((p) => !featured.includes(p)).slice(0, 6);
const countFor = (catId: string) =>
  products.filter((p) => p.categories.some((c) => c.id === catId)).length;

const headline = 'Ein Ort statt hundert offener Tabs';
const words = headline.split(' ');
const marqueeItems = ['Alle Infos an einem Ort', 'Klick dich durchs Setup', 'Ehrlich eingeordnet', 'Kein Tracking', 'Recherche ohne Tab-Chaos'];
---

<Base
  title={BRAND}
  description="Das interaktive Tech-Lexikon: Klick dich durch ein echtes Setup — jedes Gerät führt in seinen Bereich mit allen Infos. Von Monitoren bis ins Innere des PCs."
>
  <section class="pb-10 pt-14 sm:pt-20">
    <p class="meta eyebrow hw" style="--d: 80ms">Das interaktive Tech-Lexikon</p>
    <h1 class="mt-4 max-w-3xl text-4xl sm:text-6xl">
      {words.map((w, i) => (
        <span class="hw" style={`--d: ${160 + i * 60}ms`}>{w}&nbsp;</span>
      ))}<span class="hw star star-spin" style={`--d: ${160 + words.length * 60}ms`} aria-hidden="true">✳</span>
    </h1>
    <p class="hw mt-5 max-w-2xl text-lg text-muted" style={`--d: ${320 + words.length * 60}ms`}>
      Du kennst das: stundenlange Recherche über zig Seiten, bevor du irgendwas kaufst.
      {BRAND} sammelt das Wissen an einem Ort. <strong class="text-paper">Klick dich durchs Setup</strong> —
      jedes Gerät öffnet seinen Bereich. Und der PC lässt sich sogar aufschrauben.
    </p>
  </section>

  <SetupExplorer />

  <div class="marquee bleed mt-14" aria-hidden="true">
    <div class="marquee-track meta">
      {[0, 1].map(() => marqueeItems.concat(marqueeItems).map((item) => (
        <span class="flex items-center gap-3 whitespace-nowrap">
          <span class="star">✳</span>{item}
        </span>
      )))}
    </div>
  </div>

  <section aria-labelledby="bereiche" class="py-14">
    <h2 id="bereiche" class="io mb-3 text-2xl sm:text-4xl">Alle Bereiche</h2>
    <p class="io mb-8 max-w-xl text-muted">Vier Welten, viele Unterbereiche — und es werden laufend mehr.</p>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {mainCategories.map((c, i) => <CategoryTile category={c} count={countFor(c.id)} index={i} />)}
    </div>
  </section>

  {featured.length > 0 && (
    <section aria-labelledby="picks" class="py-10">
      <div class="io mb-3 flex items-baseline justify-between gap-4">
        <h2 id="picks" class="text-2xl sm:text-4xl">Die Abkürzung: MJM Picks<span class="star" aria-hidden="true">✳</span></h2>
        <a href={href('/empfehlungen')} class="whitespace-nowrap text-sm text-accent-soft hover:underline">Alle Picks →</a>
      </div>
      <p class="io mb-8 max-w-xl text-muted">
        Keine Lust auf Recherche? Optional gibt's zu ausgewählten Produkten meine ehrliche
        Empfehlung — handverlesen und klar begründet.
      </p>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section aria-labelledby="neu" class="py-10">
      <h2 id="neu" class="io mb-8 text-2xl sm:text-4xl">Neu im Lexikon</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </section>
  )}

  <p class="io mt-6 max-w-xl pb-4 text-xs text-faint sm:text-sm">
    <span class="star" aria-hidden="true">✳</span> Das Sternchen steht für Transparenz:&nbsp;{DISCLOSURE}
  </p>
</Base>
