---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryTile from '../components/CategoryTile.astro';
import { getCategories, getPublishedProducts } from '../lib/data';
import { categoryArt } from '../lib/art';
import { BRAND, href } from '../lib/site';
import type { Category } from '../lib/types';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}
const { category } = Astro.props;
const allCategories = await getCategories();
const parent = category.parent_id
  ? allCategories.find((c) => c.id === category.parent_id) ?? null
  : null;
const children = allCategories
  .filter((c) => c.parent_id === category.id)
  .sort((a, b) => a.sort_order - b.sort_order);
// Unterbereiche erben das Artwork des Hauptbereichs, bis sie eigenes bekommen
const art = categoryArt(category.slug) ?? categoryArt(parent?.slug);
const products = (await getPublishedProducts()).filter((p) =>
  p.categories.some((c) => c.id === category.id)
);
const allProducts = await getPublishedProducts();
const countFor = (catId: string) =>
  allProducts.filter((p) => p.categories.some((c) => c.id === catId)).length;

const crumbs = [
  { name: BRAND, path: '/' },
  ...(parent ? [{ name: parent.name, path: `/${parent.slug}` }] : []),
  { name: category.name, path: `/${category.slug}` },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(href(c.path), Astro.site).toString(),
  })),
};
---

<Base
  title={category.name}
  description={`${category.name} auf ${BRAND}: ${category.description}`}
  jsonLd={[breadcrumbLd]}
  noindex={products.length === 0}
>
  <nav aria-label="Brotkrumen" class="pt-8 text-sm text-muted">
    <a href={href('/')} class="hover:text-paper">Start</a>
    {parent && (
      <>
        <span aria-hidden="true"> / </span>
        <a href={href(`/${parent.slug}`)} class="hover:text-paper">{parent.name}</a>
      </>
    )}
    <span aria-hidden="true"> / </span>
    <span aria-current="page">{category.name}</span>
  </nav>

  <section
    class={`artwork hue-${category.hue} relative mt-6 mb-12 flex min-h-64 flex-col justify-end overflow-hidden rounded-3xl border border-line p-6 sm:min-h-80 sm:p-10`}
  >
    {art && (
      <Image
        src={art}
        alt=""
        widths={[828, 1280, 1920]}
        sizes="(min-width: 1280px) 1152px, 92vw"
        loading="eager"
        quality={75}
      />
    )}
    <span class="tint" aria-hidden="true"></span>
    <h1 class="relative z-10 text-3xl sm:text-6xl">{category.name}</h1>
    <p class="relative z-10 mt-3 max-w-xl text-lg text-paper/85">{category.description}</p>
  </section>

  {children.length > 0 && (
    <section aria-label="Unterbereiche" class="mb-12">
      <p class="meta mb-4">Unterbereiche</p>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {children.map((c, i) => <CategoryTile category={c} count={countFor(c.id)} index={i} />)}
      </div>
    </section>
  )}

  {products.length > 0 ? (
    <div class="grid gap-5 pb-8 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p, i) => <ProductCard product={p} index={i} />)}
    </div>
  ) : (
    <section class="mb-8 rounded-2xl border border-line bg-coal p-8 text-muted">
      <p>In dieser Kategorie ist noch kein Pick eingezogen. Schau bald wieder vorbei —
      oder stöbere solange in den <a class="text-accent-soft underline" href={href('/empfehlungen')}>Top-Picks</a>.</p>
    </section>
  )}
</Base>
