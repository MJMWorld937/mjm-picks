---
import type { AffiliateProduct, PicksScore } from '../lib/types';
import { href } from '../lib/site';

interface Props {
  products: AffiliateProduct[];
  scores: PicksScore[];
  categoryName: string;
  /** Slug des Produkts, das gerade angezeigt wird — wird in der Liste hervorgehoben. */
  activeSlug?: string;
}
const { products, scores, categoryName, activeSlug } = Astro.props;

// Nur veröffentlichte Scores fließen ins Ranking; Picks ohne Score hängen wir
// unsortiert hinten an, statt sie zu verschweigen.
const byId = new Map(scores.map((s) => [s.productId, s]));
const ranked = products
  .map((product) => ({ product, score: byId.get(product.id) ?? null }))
  .sort((a, b) => {
    if (a.score && b.score) return b.score.total - a.score.total;
    if (a.score) return -1;
    if (b.score) return 1;
    return a.product.title.localeCompare(b.product.title, 'de');
  });

const mitScore = ranked.filter((r) => r.score).length;
const fmt = (total: number) => (total / 10).toFixed(1).replace('.', ',');
---

{ranked.length > 1 && (
  <aside aria-label={`Rangliste ${categoryName}`} class="rank">
    <p class="meta mb-3">Rangliste {categoryName}</p>
    <ol class="space-y-1">
      {ranked.map((entry, i) => {
        const isActive = activeSlug && entry.product.slug === activeSlug;
        return (
          <li>
            <a
              href={href(`/produkt/${entry.product.slug}`)}
              class:list={['row', { active: isActive }]}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="pos" aria-hidden="true">{entry.score ? i + 1 : '–'}</span>
              <span class="name">{entry.product.title}</span>
              {entry.score ? (
                <span class="val">{fmt(entry.score.total)}</span>
              ) : (
                <span class="val val-none" title="Für einen Score reicht die Quellenlage noch nicht">·</span>
              )}
            </a>
          </li>
        );
      })}
    </ol>
    <p class="mt-3 text-xs leading-relaxed text-muted">
      Sortiert nach <a class="underline hover:text-paper" href={href('/methodik')}>PICKS-Score</a>.
      {mitScore < ranked.length && ' Ein Punkt steht für einen Pick, dessen Quellenlage für einen Score noch nicht reicht.'}
    </p>
  </aside>
)}

<style>
  .rank {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--coal);
    padding: 1.25rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    border-radius: 0.6rem;
    padding: 0.45rem 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .row:hover {
    background: color-mix(in oklab, var(--paper) 7%, transparent);
  }
  .row.active {
    background: color-mix(in oklab, var(--accent) 16%, transparent);
  }
  .pos {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    color: var(--muted);
    text-align: right;
  }
  .row.active .pos {
    color: var(--accent-soft);
  }
  .name {
    font-size: 0.9rem;
    line-height: 1.35;
    /* Lange Produktnamen dürfen umbrechen statt die Spalte zu sprengen. */
    overflow-wrap: anywhere;
  }
  .val {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--accent-soft);
    font-variant-numeric: tabular-nums;
  }
  .val-none {
    color: var(--muted);
  }
</style>
