---
import type { AffiliateProduct, PicksScore, RankingGroup } from '../lib/types';
import { href } from '../lib/site';

interface Props {
  products: AffiliateProduct[];
  scores: PicksScore[];
  groups: RankingGroup[];
  categoryName: string;
  /** data-f-*-Attribute je Produkt-Id, damit die Liste mitgefiltert wird */
  filterAttrs?: Map<string, Record<string, string>>;
  /** Slug des Produkts, das gerade angezeigt wird — wird in der Liste hervorgehoben. */
  activeSlug?: string;
}
const { products, scores, groups, categoryName, activeSlug, filterAttrs } = Astro.props;

// Nur veröffentlichte Scores fließen ins Ranking; Picks ohne Score hängen wir
// unsortiert hinten an, statt sie zu verschweigen.
const byId = new Map(scores.map((s) => [s.productId, s]));
const sortiere = (
  a: { product: AffiliateProduct; score: PicksScore | null },
  b: { product: AffiliateProduct; score: PicksScore | null }
) => {
  if (a.score && b.score) return b.score.total - a.score.total;
  if (a.score) return -1;
  if (b.score) return 1;
  return a.product.title.localeCompare(b.product.title, 'de');
};

const alle = products.map((product) => ({ product, score: byId.get(product.id) ?? null }));

// Nach Einsatzklasse gruppieren. Ein reines Score-Ranking würde eine sehr gute
// Einsteigerkarte über eine sehr gute Oberklassekarte stellen — verglichen wird
// deshalb nur innerhalb einer Klasse.
const reihenfolge = new Map(groups.map((g) => [g.name, g.sortOrder]));
const namen = [...new Set(alle.map((e) => e.product.rankingGroup).filter(Boolean))] as string[];
namen.sort((a, b) => (reihenfolge.get(a) ?? 9999) - (reihenfolge.get(b) ?? 9999));

const bloecke = namen.map((name) => ({
  name,
  beschreibung: groups.find((g) => g.name === name)?.description ?? null,
  eintraege: alle.filter((e) => e.product.rankingGroup === name).sort(sortiere),
}));

// Was keiner Klasse zugeordnet ist, kommt als eigener Block ans Ende
const ohneGruppe = alle.filter((e) => !e.product.rankingGroup).sort(sortiere);
if (ohneGruppe.length > 0) {
  bloecke.push({ name: 'Weitere Picks', beschreibung: null, eintraege: ohneGruppe });
}

const ohneScore = alle.filter((e) => !e.score).length;
const fmt = (total: number) => (total / 10).toFixed(1).replace('.', ',');
---

{alle.length > 1 && (
  <aside aria-label={`Rangliste ${categoryName}`} class="rank">
    <p class="meta mb-1">Rangliste {categoryName}</p>
    <p class="mb-4 text-xs leading-relaxed text-faint">Nach Einsatzklasse getrennt — verglichen wird nur, was denselben Zweck hat.</p>

    {bloecke.map((block) => (
      <section class="block" data-rang-block>
        <h3 class="gruppe">
          {block.name}
          <span class="zahl" data-rang-zahl>{block.eintraege.length > 1 ? block.eintraege.length : ''}</span>
        </h3>
        {block.beschreibung && <p class="erklaerung">{block.beschreibung}</p>}
        <ol class="space-y-1">
          {block.eintraege.map((entry, i) => {
            const isActive = activeSlug && entry.product.slug === activeSlug;
            return (
              <li data-rang-zeile {...(filterAttrs?.get(entry.product.id) ?? {})}>
                <a
                  href={href(`/produkt/${entry.product.slug}`)}
                  class:list={['row', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="pos" aria-hidden="true" data-rang-pos data-ohne-score={entry.score ? undefined : 'true'}>{entry.score ? i + 1 : '–'}</span>
                  <span class="name">{entry.product.title}</span>
                  {entry.score ? (
                    <span class="val">{fmt(entry.score.total)}</span>
                  ) : (
                    <span class="val val-none" title="Für einen Score reicht die Quellenlage noch nicht">·</span>
                  )}
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <p class="mt-4 border-t border-line pt-3 text-xs leading-relaxed text-muted">
      Innerhalb jeder Klasse sortiert nach <a class="underline hover:text-paper" href={href('/methodik')}>PICKS-Score</a>.
      {ohneScore > 0 && ' Ein Punkt steht für einen Pick, dessen Quellenlage für einen Score noch nicht reicht.'}
    </p>
  </aside>
)}

<style>
  .rank {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--coal);
    padding: 1.25rem;
  }
  /* Ab Tablet steht die Liste fest neben den Karten. Wird sie länger als der
     Bildschirm — bei zwanzig Prozessoren in vier Klassen schnell der Fall —,
     scrollt sie für sich, statt unten abgeschnitten zu sein. */
  @media (min-width: 64rem) {
    .rank {
      max-height: calc(100svh - 8rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--line) transparent;
    }
    .rank::-webkit-scrollbar {
      width: 8px;
    }
    .rank::-webkit-scrollbar-track {
      background: transparent;
    }
    .rank::-webkit-scrollbar-thumb {
      background: var(--line);
      border-radius: 9999px;
    }
    .rank::-webkit-scrollbar-thumb:hover {
      background: #3b332b;
    }
    /* Die Überschrift der Klasse bleibt stehen, solange man in ihr scrollt. */
    .gruppe {
      position: sticky;
      top: -1.25rem;
      z-index: 1;
      padding-block: 0.35rem;
      margin-block: -0.35rem 0.15rem;
      background: var(--coal);
    }
  }
  .block + .block {
    margin-top: 1.4rem;
  }
  .gruppe {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-display, sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--paper);
    margin: 0 0 0.15rem;
  }
  .zahl {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    color: var(--faint);
  }
  .erklaerung {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--faint);
  }
  .row {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    border-radius: 0.6rem;
    padding: 0.45rem 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .row:hover {
    background: color-mix(in oklab, var(--paper) 7%, transparent);
  }
  .row.active {
    background: color-mix(in oklab, var(--accent) 16%, transparent);
  }
  .pos {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    color: var(--muted);
    text-align: right;
  }
  .row.active .pos {
    color: var(--accent-soft);
  }
  .name {
    font-size: 0.9rem;
    line-height: 1.35;
    /* Lange Produktnamen dürfen umbrechen statt die Spalte zu sprengen. */
    overflow-wrap: anywhere;
  }
  .val {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--accent-soft);
    font-variant-numeric: tabular-nums;
  }
  .val-none {
    color: var(--muted);
  }
</style>
