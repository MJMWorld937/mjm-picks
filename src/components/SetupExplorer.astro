---
import { Image } from 'astro:assets';
import { scenes } from '../content/scenes';
import { href } from '../lib/site';

const startScene = scenes[0]?.id ?? 'desk';
// Einblende-Verzögerung der Hotspots je Szene
const hotspotDelay: Record<string, string> = { desk: '250ms', 'pc-innen': '450ms' };
---

<section id="setup-explorer" class="bleed" aria-label="Interaktives Setup — klick auf ein Gerät">
  <div class="relative">
  <div class="exp-ui" aria-live="polite">
    {scenes.map((scene) => (
      <div
        class="exp-ui-row"
        data-scene-ui={scene.id}
        style={scene.id === startScene ? 'display:flex' : 'display:none'}
      >
        <p class="meta exp-ui-title">{scene.title}</p>
        {scene.backTo && (
          <button class="exp-back meta" data-goto={scene.backTo} type="button">← Zurück zum Setup</button>
        )}
      </div>
    ))}
  </div>
  <div class="exp-viewport" id="exp-viewport">
    <div class="exp-stage" id="exp-stage">
      {scenes.map((scene, si) => (
        <div
          class="exp-scene"
          data-scene={scene.id}
          data-active={scene.id === startScene ? 'true' : undefined}
          aria-hidden={scene.id === startScene ? undefined : 'true'}
          style={`--hsd: ${hotspotDelay[scene.id] ?? '250ms'}`}
        >
          <Image
            src={scene.art}
            alt={scene.artAlt}
            widths={[828, 1440, 1920, 2560, 3840]}
            sizes="(orientation: portrait) 170vh, 100vw"
            loading={si === 0 ? 'eager' : 'lazy'}
            fetchpriority={si === 0 ? 'high' : undefined}
            quality={85}
            class="exp-art"
          />
          <div class="exp-vignette" aria-hidden="true"></div>

          {scene.hotspots.map((h, i) =>
            h.target.type === 'bereich' ? (
              <a
                href={href(`/${h.target.slug}`)}
                class="hotspot"
                style={`--hx: ${h.x}%; --hy: ${h.y}%; --pd: ${i * 350}ms`}
                aria-label={`Bereich öffnen: ${h.label}`}
              >
                <span class="hs-ping" aria-hidden="true"></span>
                <span class="hs-dot" aria-hidden="true">✳</span>
                <span class="hs-label">{h.label}</span>
              </a>
            ) : (
              <button
                type="button"
                class="hotspot hotspot-scene"
                data-goto={h.target.id}
                style={`--hx: ${h.x}%; --hy: ${h.y}%; --pd: ${i * 350}ms`}
                aria-label={h.label}
              >
                <span class="hs-ping" aria-hidden="true"></span>
                <span class="hs-dot" aria-hidden="true">+</span>
                <span class="hs-label">{h.label}</span>
              </button>
            )
          )}
        </div>
      ))}

      <!-- Cinema-Sequenz: Seitenwand wird abgeschraubt (Video, endet auf der Innenansicht) -->
      <div class="exp-video" id="exp-video" hidden aria-hidden="true">
        <video
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/media/pc-aufschrauben.mp4`}
          playsinline
          muted
          preload="metadata"
        ></video>
      </div>
    </div>
  </div>
  </div>

  <div class="mx-auto mt-4 w-full max-w-6xl px-4 sm:px-6">
    {scenes.map((scene) => (
      <div
        class="flex-wrap items-center gap-2"
        data-scene-legend={scene.id}
        style={scene.id === startScene ? 'display:flex' : 'display:none'}
      >
        <span class="meta mr-1">{scene.title}:</span>
        {scene.hotspots.map((h) =>
          h.target.type === 'bereich' ? (
            <a
              href={href(`/${h.target.slug}`)}
              class="rounded-full border border-line px-3 py-1 text-xs text-muted no-underline transition-colors hover:border-accent hover:text-paper"
            >
              {h.label}
            </a>
          ) : (
            <button
              type="button"
              data-goto={h.target.id}
              class="rounded-full border border-accent/60 px-3 py-1 text-xs text-accent-soft transition-colors hover:border-accent hover:text-paper"
            >
              {h.label} ↗
            </button>
          )
        )}
      </div>
    ))}
  </div>
</section>

<script>
  const root = document.getElementById('setup-explorer');
  const viewport = document.getElementById('exp-viewport');
  const videoWrap = document.getElementById('exp-video');
  const video = videoWrap?.querySelector('video') ?? null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && viewport) {
    // Beim Laden mittig ausrichten (mobil ist die Bühne breiter als der Bildschirm)
    viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;

    const setScene = (id: string) => {
      root.querySelectorAll<HTMLElement>('.exp-scene').forEach((s) => {
        const active = s.dataset.scene === id;
        if (active) {
          s.setAttribute('data-active', 'true');
          s.removeAttribute('aria-hidden');
        } else {
          s.removeAttribute('data-active');
          s.setAttribute('aria-hidden', 'true');
        }
      });
      root.querySelectorAll<HTMLElement>('[data-scene-legend]').forEach((l) => {
        l.style.display = l.dataset.sceneLegend === id ? 'flex' : 'none';
      });
      root.querySelectorAll<HTMLElement>('[data-scene-ui]').forEach((u) => {
        u.style.display = u.dataset.sceneUi === id ? 'flex' : 'none';
      });
    };

    // Cinema-Sequenz: Video spielt, am Ende übernimmt nahtlos die interaktive Szene
    let playing = false;
    const hideVideo = () => {
      videoWrap?.classList.remove('on');
      window.setTimeout(() => {
        if (videoWrap) videoWrap.hidden = true;
      }, 500);
    };
    const playIntro = (done: () => void) => {
      if (!video || !videoWrap || reduced || playing) {
        done();
        return;
      }
      playing = true;
      root.classList.add('video-running');
      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;
        playing = false;
        root.classList.remove('video-running');
        done();
        hideVideo();
      };
      videoWrap.hidden = false;
      requestAnimationFrame(() => videoWrap.classList.add('on'));
      video.currentTime = 0;
      video.onended = finish;
      video.onerror = finish;
      const p = video.play();
      if (p) p.catch(finish);
      // Sicherheitsnetz, falls 'ended' nie feuert
      window.setTimeout(finish, 12000);
    };

    root.addEventListener('click', (e) => {
      const gotoEl = (e.target as HTMLElement).closest<HTMLElement>('[data-goto]');
      if (!gotoEl?.dataset.goto) return;
      const id = gotoEl.dataset.goto;
      if (id === 'pc-innen') {
        playIntro(() => setScene(id));
      } else {
        if (video && !video.paused) video.pause();
        hideVideo();
        playing = false;
        setScene(id);
      }
    });
  }
</script>
