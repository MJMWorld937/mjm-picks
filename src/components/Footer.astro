---
import Zeichen from './Zeichen.astro';
import { BRAND, DISCLOSURE, href } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
    <p class="max-w-2xl text-sm text-muted">
      <Zeichen class="star star-vorn" />
      {DISCLOSURE} Links zu Amazon sind bezahlte Links — für dich ändert sich am Preis nichts.
      Mehr dazu im <a class="underline underline-offset-2 hover:text-paper" href={href('/affiliate-hinweis')}>Affiliate-Hinweis</a>.
    </p>
    <nav aria-label="Rechtliches" class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
      <a class="hover:text-paper" href={href('/ueber')}>Über {BRAND}</a>
      <a class="hover:text-paper" href={href('/methodik')}>PICKS-Methodik</a>
      <a class="hover:text-paper" href={href('/affiliate-hinweis')}>Affiliate-Hinweis</a>
      <a class="hover:text-paper" href={href('/impressum')}>Impressum</a>
      <a class="hover:text-paper" href={href('/datenschutz')}>Datenschutz</a>
    </nav>
    <p class="mt-6 text-xs text-faint">© {year} {BRAND}. Ohne Tracking, ohne Cookies — einfach Empfehlungen.</p>
  </div>
</footer>
