---
import Zeichen from './Zeichen.astro';
import NavDrawer from './NavDrawer.astro';
import { BRAND, href } from '../lib/site';

interface Props {
  /** über Full-Bleed-Hero: absolut + durchsichtig statt sticky Glas */
  transparent?: boolean;
  /** Breitenklasse des Inhalts — der Header laeuft mit, damit die Marke darueber sitzt */
  bahn?: string;
}
const { transparent = false, bahn = 'max-w-6xl' } = Astro.props;

const current = Astro.url.pathname;
const isActive = (path: string) => current === href(path) || current === `${href(path)}/`;
---

<header
  class:list={[
    'z-40',
    transparent
      ? 'absolute inset-x-0 top-0 bg-gradient-to-b from-ink/70 to-transparent'
      : 'sticky top-0 border-b border-line bg-ink/85 backdrop-blur-md',
  ]}
>
  <div class:list={['mx-auto flex w-full items-center justify-between gap-6 px-4 py-3 sm:px-6', bahn]}>
    <a href={href('/')} class="flex items-baseline gap-0.5 font-display text-lg font-bold tracking-tight no-underline">
      {BRAND}<Zeichen class="star star-anhang" />
    </a>
    <nav aria-label="Hauptnavigation" class="flex items-center gap-2">
      <a
        href={href('/empfehlungen')}
        aria-current={isActive('/empfehlungen') ? 'page' : undefined}
        class:list={[
          'hidden whitespace-nowrap rounded-full px-3 py-1.5 text-sm transition-colors sm:inline-block',
          isActive('/empfehlungen') ? 'bg-coal text-paper' : 'text-muted hover:text-paper',
        ]}
      >
        Top-Picks
      </a>
      <button
        id="nav-drawer-btn"
        aria-haspopup="dialog"
        aria-controls="nav-drawer"
        class="flex items-center gap-2 rounded-full border border-faint/50 px-4 py-1.5 text-sm text-paper transition-colors hover:border-accent hover:text-accent-soft"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
          <rect x="0" y="0" width="6" height="6" rx="1.5" />
          <rect x="8" y="0" width="6" height="6" rx="1.5" />
          <rect x="0" y="8" width="6" height="6" rx="1.5" />
          <rect x="8" y="8" width="6" height="6" rx="1.5" />
        </svg>
        Kategorien
      </button>
    </nav>
  </div>
</header>

<NavDrawer />
