---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** true bei Admin & 404 */
  noindex?: boolean;
  /** zusätzliches JSON-LD (BreadcrumbList, Product …) */
  jsonLd?: object[];
  /** Seite beginnt mit Full-Bleed-Hero (Header liegt darüber) */
  fullBleedTop?: boolean;
}

const { title, description, noindex = false, jsonLd = [], fullBleedTop = false } = Astro.props;
// Teilbild fürs Web: feste Datei statt zugeschnittenem Hero-Motiv, damit beim Teilen
// Markenzeichen und Name mitkommen. Die URL bleibt stabil — Discord, Slack und
// Facebook merken sich das Bild pro URL und laden es sonst nicht neu.
const ogImageUrl = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og-mjm-picks.jpg`,
  Astro.site
);
const canonical = new URL(Astro.url.pathname, Astro.site);
// Staging (github.io) nie indexieren — verhindert Duplicate Content vor dem Domain-Umzug
const isStaging = Astro.site?.hostname.endsWith('github.io') ?? false;
const fullTitle = title === BRAND ? `${BRAND} · Handverlesene Tech-Empfehlungen` : `${title} · ${BRAND}`;

const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: BRAND,
  url: Astro.site?.toString(),
  inLanguage: 'de-DE',
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isStaging) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#14110e" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND} — Handverlesene Tech-Empfehlungen`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="bg-ink text-paper antialiased">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent focus:text-ink focus:px-4 focus:py-2 focus:rounded"
    >
      Zum Inhalt springen
    </a>
    <Header transparent={fullBleedTop} />
    <main id="inhalt" class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/enhance.js';
    </script>
  </body>
</html>
